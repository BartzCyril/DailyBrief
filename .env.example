DATABASE_URL=postgresql://dailybrief:dailybrief@127.0.0.1:5432/dailybrief
POSTGRES_USER=dailybrief
POSTGRES_PASSWORD=dailybrief
POSTGRES_DB=dailybrief
POSTGRES_PORT=5432
PORT=3000
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379
SESSION_SECRET=
# Set a stable 32-byte hex key outside the database in deployment configuration.
# JOURNAL_ENCRYPTION_KEY=<64 hexadecimal characters>; env:prepare generates a local key.
SESSION_COOKIE_NAME=dailybrief.sid
SESSION_MAX_AGE=604800000
FRONTEND_ORIGIN=http://localhost:5173
TEST_DATABASE_URL=postgresql://dailybrief:dailybrief@127.0.0.1:5432/dailybrief_test
# Optional executable override; otherwise Puppeteer uses its cached Chrome for Testing.
# Install it with `bun run browser:install` (Linux dependencies: browser:install:deps).
CHROMIUM_EXECUTABLE_PATH=
# Wait for a transient browser-verification screen; 0 disables waiting, maximum 120000 ms.
SCRAPING_VERIFICATION_WAIT_MS=30000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Per generation, including model loading; CPU inference can take several minutes.
OLLAMA_TIMEOUT_MS=1800000
# All portions are summarized, then combined; the article is never truncated.
AI_MAX_INPUT_CHARS=16000
AI_CONCURRENCY=1
# Redis namespace shared by API and worker; use a different value for each deployment.
QUEUE_PREFIX=dailybrief
# Source discovery/newsletter runs; article jobs still obey AI_CONCURRENCY globally.
COLLECTION_CONCURRENCY=2
AI_LANGUAGE=français
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Also receives selector help requests: use a valid email address to enable them.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=dailybrief@example.com
# Console: info (default), debug for request details/retries, or error.
LOG_LEVEL=info
# Optional: pretty locally (default), json in production (default).
# LOG_FORMAT=json
# Relative to the project root, independently of the backend working directory.
LOG_ERROR_FILE=.error
# Errors and fatal failures use the SMTP settings above. Tests never send real alerts.
ERROR_EMAIL_ENABLED=true
# Optional recipient override; defaults to SMTP_USER when it is an email address.
ERROR_EMAIL_TO=
# One email per service/event/error code in this period; all errors remain in .error.
ERROR_EMAIL_COOLDOWN_MS=300000
