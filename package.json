{
  "name": "dailybrief",
  "private": true,
  "version": "1.0.0",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "scripts": {
    "dev:backend": "bun --env-file=../.env run --cwd backend dev",
    "dev:worker": "bun --env-file=../.env run --cwd backend worker:dev",
    "start:worker": "bun --env-file=../.env run --cwd backend worker",
    "dev:frontend": "bun run --cwd frontend dev",
    "typecheck": "bun run --cwd backend typecheck && bun run --cwd frontend typecheck",
    "build": "bun run --cwd frontend build",
    "test": "bun --env-file=../.env run --cwd backend test && bun run --cwd frontend test",
    "db:generate": "bun --env-file=../.env run --cwd backend db:generate",
    "db:migrate": "bun --env-file=../.env run --cwd backend db:migrate",
    "services:up": "docker compose up -d --wait postgres redis",
    "services:down": "docker compose down",
    "browser:install": "bun run --cwd backend playwright install chromium",
    "browser:prepare": "bun run --cwd backend scripts/prepare-browser.ts",
    "diagnose:page": "bun --env-file=../.env run --cwd backend scripts/diagnose-page.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "bun --env-file=../.env run --cwd backend scripts/prepare-test-db.ts && bun --env-file=../.env run --cwd backend scripts/test-e2e.ts",
    "env:prepare": "bun run --cwd backend scripts/prepare-local-env.ts"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
