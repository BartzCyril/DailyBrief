# Generated with ./deploy.sh init https://brief.example.com
APP_DOMAIN=localhost
APP_ORIGIN=https://localhost
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_USER=dailybrief
POSTGRES_DB=dailybrief
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
JOURNAL_ENCRYPTION_KEY=

OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=1800000
AI_MAX_INPUT_CHARS=16000
AI_CONCURRENCY=1
COLLECTION_CONCURRENCY=2
QUEUE_PREFIX=dailybrief
AI_LANGUAGE=français
SCRAPING_VERIFICATION_WAIT_MS=30000

# Mailpit captures messages locally. Set your SMTP provider for real delivery.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=dailybrief@example.com
MAILPIT_WEB_PORT=8025
ERROR_EMAIL_ENABLED=false
ERROR_EMAIL_TO=
ERROR_EMAIL_COOLDOWN_MS=300000
LOG_LEVEL=info
