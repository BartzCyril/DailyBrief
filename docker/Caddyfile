{$APP_DOMAIN:localhost} {
  encode zstd gzip

  @api path /api /api/*
  handle @api {
    uri strip_prefix /api
    reverse_proxy api:3000 {
      flush_interval -1
      transport http {
        response_header_timeout 1900s
      }
    }
  }

  handle {
    root * /srv
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    try_files {path} /index.html
    file_server
  }
}
