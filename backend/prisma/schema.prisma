generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sources Source[]
  settings DailyBriefSettings?
  articles Article[]
  newsletters Newsletter[]
  runs DailyBriefRun[]
}
model DailyBriefSettings {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionEnabled Boolean @default(false)
  collectionTime String @default("07:30")
  timezone String @default("Europe/Paris")
  lastCollectionAt DateTime?
  nextCollectionAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([collectionEnabled, nextCollectionAt])
}
enum SourceType {
  RSS
  SCRAPING
}
model Source {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  url String
  type SourceType
  scrapingConfig Json?
  articleLinkSelector String?
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  articles Article[]
  @@unique([userId, url])
}
model Article {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId String
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title String
  url String?
  canonicalUrl String?
  guid String?
  content String?
  contentFetchedAt DateTime?
  contentUrl String?
  contentLinkSelector String?
  contentError String?
  description String?
  publishedAt DateTime?
  contentHash String
  fingerprint String @unique
  summaryTitle String?
  summary String?
  keyPoints String[] @default([])
  summarizedAt DateTime?
  summaryError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  newsletters NewsletterArticle[]
  @@unique([userId, canonicalUrl])
  @@unique([userId, contentHash])
  @@unique([sourceId, guid])
  @@index([userId, summarizedAt])
}
enum NewsletterStatus {
  GENERATING
  READY
  SENDING
  SENT
  FAILED
}
model Newsletter {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  status NewsletterStatus @default(GENERATING)
  generatedAt DateTime @default(now())
  sentAt DateTime?
  recipientEmail String
  subject String
  error String?
  createdAt DateTime @default(now())
  articles NewsletterArticle[]
  @@index([userId, status])
}
model NewsletterArticle {
  newsletterId String
  newsletter Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  articleId String
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  @@id([newsletterId, articleId])
  @@index([articleId])
}
model DailyBriefRun {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())
  finishedAt DateTime?
  status String @default("RUNNING")
  sourcesProcessed Int @default(0)
  sourcesFailed Int @default(0)
  articlesCollected Int @default(0)
  newArticles Int @default(0)
  articlesSummarized Int @default(0)
  emailSent Boolean @default(false)
  error String?
  sourceResults Json?
  @@index([userId, startedAt])
}
