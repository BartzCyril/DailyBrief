generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sources Source[]
  settings DailyBriefSettings?
}
model DailyBriefSettings {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionEnabled Boolean @default(false)
  collectionTime String @default("07:30")
  timezone String @default("Europe/Paris")
  lastCollectionAt DateTime?
  nextCollectionAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([collectionEnabled, nextCollectionAt])
}
enum SourceType {
  RSS
  SCRAPING
}
model Source {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  url String
  type SourceType
  scrapingConfig Json?
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, url])
}
