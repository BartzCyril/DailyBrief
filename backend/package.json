{
  "name": "@dailybrief/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/prepare-test-db.ts && bun test tests",
    "db:generate": "prisma generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@dailybrief/shared": "workspace:*",
    "@prisma/adapter-pg": "6.19.2",
    "@prisma/client": "6.19.2",
    "cheerio": "^1.2.0",
    "connect-redis": "^10.0.0",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "luxon": "^3.7.2",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "playwright": "^1.63.0",
    "redis": "^6.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/luxon": "^3.7.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "6.19.2",
    "supertest": "^7.3.1",
    "typescript": "^5.9.0"
  }
